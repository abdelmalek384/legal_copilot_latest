# Copy to .env.production and set real values in a protected secret-management process.
# Never commit .env.production. Use one application replica with this SQLite topology.
LEGAL_COPILOT_IMAGE_TAG=REPLACE_WITH_IMMUTABLE_RELEASE_TAG

COPILOT_ENV=production
COPILOT_CONTROL_DB=/var/lib/legal-copilot/control/control_plane.sqlite3
COPILOT_TENANT_DB_ROOT=/var/lib/legal-copilot/tenants
COPILOT_CORPUS_DB=/var/lib/legal-copilot/corpus/legal_corpus.sqlite3
COPILOT_DATABASE_ACCEPTANCE_FILE=/run/secrets/database-acceptance.json
COPILOT_OBJECT_STORAGE_BACKEND=s3
COPILOT_ALLOWED_HOSTS=
COPILOT_PUBLIC_ORIGIN=
COPILOT_SECURE_COOKIES=1
MFA_ENFORCEMENT=admins_required

# Generate independent keys using documented CLI commands. Never reuse keys.
ADMIN_TOKEN=PLACEHOLDER_SET_IN_SECRET_MANAGER
BACKUP_KEY=
MFA_ENCRYPTION_KEY=

# S3/KMS values are configuration identifiers, not static access credentials.
COPILOT_S3_BUCKET=
COPILOT_S3_REGION=
COPILOT_S3_KMS_KEY_ID=
# Separate versioned encrypted archive for database/original-file recovery bundles.
COPILOT_S3_RECOVERY_BUCKET=
COPILOT_S3_RECOVERY_REGION=
COPILOT_S3_RECOVERY_KMS_KEY_ID=
COPILOT_S3_RECOVERY_ENDPOINT_URL=
# Prefer an instance/task role or workload identity. Do not store AWS access keys here.

# Configure the approved SMTP provider. Leave username/password both empty only
# when the provider explicitly supports authenticated network access without them.
COPILOT_EMAIL_SMTP_HOST=
COPILOT_EMAIL_SMTP_PORT=587
COPILOT_EMAIL_SMTP_SECURITY=starttls
COPILOT_EMAIL_FROM=
COPILOT_EMAIL_SMTP_USERNAME=
COPILOT_EMAIL_SMTP_PASSWORD=

# Optional LLM endpoint. Keep both approval attestations unset until the exact
# provider, model, retention and matter-data terms have been reviewed.
LLM_URL=
LLM_MODEL=
LLM_KEY=
LLM_DATA_PROCESSING_APPROVED=
LLM_FIRM_DATA_PROCESSING_APPROVED=
